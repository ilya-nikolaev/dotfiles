set clipboard=unnamedplus

set autoindent
set expandtab
set shiftround
set shiftwidth=4
set smarttab
set tabstop=4

set encoding=utf-8
set linebreak
set scrolloff=3
set sidescrolloff=5
syntax enable
set wrap

set laststatus=2
set ruler
set cursorline
set number
set relativenumber
set noerrorbells

set autoread
